---
import BaseHead from "../components/BaseHead.astro";
import BackgroundGrid from "../components/BackgroundGrid.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SkillScroller from "../components/SkillScroller.svelte";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import cvPdf from "../assets/cv.pdf";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<BackgroundGrid />
		<Header />
		<section class="intro">
			<h1>Oisín Mulhall</h1>
			<p>
				Studying Immersive Software Engineering at the University of Limerick. Interested in
				building performant, elegant solutions across various domains from the web to bare
				metal. Want to connect? Here is my{" "}
				<a href="https://www.linkedin.com/in/omulhall/">LinkedIn</a>. Want to employ me?
				Here is my <a href={cvPdf}>CV</a>.
			</p>
		</section>
		<main class="about-layout">
			<section class="about">
				<h2>About me</h2>
				<p>
					Born, bred and currently based in Limerick, Ireland. I'm currently a first year
					@ Immersive Software Engineering, developing my craft under the guidance of
					industry professionals, academics and entrepreneurs.
				</p>
				<p>
					My love for programming and software began when I was 16, when I decided to
					learn a bit of HTML at freecodecamp.org. Since then I have worked on numerous
					solo and group project including compilers, web engines, web apps and CLIs.
				</p>
			</section>
			<section class="scrollers">
				<h3 class="scroller-label">Technologies</h3>
				<SkillScroller
					client:load
					items={["Java", "Python", "Rust", "C", "Git", "Linux"]}
					speed={15}
				/>
				<h3 class="scroller-label">Interests</h3>
				<SkillScroller
					client:load
					items={["Systems", "Databases", "Embedded"]}
					speed={15}
				/>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		text-align: center;
		padding: 1em 3em;
	}

	.intro h1,
	.intro p {
		max-width: 720px;
		margin-left: auto;
		margin-right: auto;
	}

	.intro h1 {
		font-size: 2.5rem;
	}

	.about-layout {
		display: flex;
		justify-content: left;
		align-items: center;
		gap: 12rem;
		max-width: 1200px;
		margin: 0 4rem;
		padding: 0 2rem;
	}

	.about {
		flex: 2 1 0;
		align-self: center;
		min-width: 600px;
	}

	.scrollers {
		flexf: 1 1 0;
		padding: 2em 0;
		min-width: 300px;
	}

	.about h2,
	.scroller-label {
		margin-top: 0;
	}

	@media (max-width: 768px) {
		.about-layout {
			flex-direction: column;
			gap: 2rem;
		}
	}
</style>
